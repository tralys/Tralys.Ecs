<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <_SmokeTargetRid>$(RuntimeIdentifier)</_SmokeTargetRid>
    <_SmokeTargetRid Condition="'$(_SmokeTargetRid)' == ''"
      >$(NETCoreSdkPortableRuntimeIdentifier)</_SmokeTargetRid
    >
    <IlcInstructionSet Condition="$(_SmokeTargetRid.EndsWith('-x64'))">x86-64-v3</IlcInstructionSet>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tralys.Ecs/Tralys.Ecs.csproj" />
    <ProjectReference Include="../../src/Tralys.Ecs.Scheduling/Tralys.Ecs.Scheduling.csproj" />
    <ProjectReference Include="../../src/Tralys.Ecs.Executor.Pool/Tralys.Ecs.Executor.Pool.csproj" />
    <ProjectReference Include="../../src/Tralys.Ecs.Testing/Tralys.Ecs.Testing.csproj" />
    <ProjectReference Include="../Tralys.Ecs.Downstream.Fixture/Tralys.Ecs.Downstream.Fixture.csproj" />
    <ProjectReference
      Include="../../src/Tralys.Ecs.Generators/Tralys.Ecs.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
