<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tralys.Ecs/Tralys.Ecs.csproj" />
    <ProjectReference Include="../../src/Tralys.Ecs.Scheduling/Tralys.Ecs.Scheduling.csproj" />
    <ProjectReference
      Include="../../src/Tralys.Ecs.Generators/Tralys.Ecs.Generators.csproj"
      ReferenceOutputAssembly="true"
    />
  </ItemGroup>

  <Target Name="WriteHarnessReferences" AfterTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <_HarnessReference
        Include="@(ReferencePathWithRefAssemblies)"
        Condition="'%(ReferencePathWithRefAssemblies.FrameworkReferenceName)' == 'Microsoft.NETCore.App' or '%(ReferencePathWithRefAssemblies.Filename)' == 'Tralys.Ecs' or '%(ReferencePathWithRefAssemblies.Filename)' == 'Tralys.Ecs.Scheduling'"
      />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)" />
    <WriteLinesToFile
      File="$(OutDir)harness.references"
      Lines="@(_HarnessReference->'%(FullPath)')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
    <ItemGroup>
      <FileWrites Include="$(OutDir)harness.references" />
    </ItemGroup>
  </Target>
</Project>
