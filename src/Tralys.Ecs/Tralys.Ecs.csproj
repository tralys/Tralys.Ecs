<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
    <IsPackable>true</IsPackable>
    <Description>A source-generated entity component system: worlds, archetype storage, relations, hierarchy, commands, observers and change tracking, with its generator and analyzers.</Description>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="../Tralys.Ecs.Generators/Tralys.Ecs.Generators.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
  </ItemGroup>

  <Target Name="PackGenerator">
    <MSBuild Projects="../Tralys.Ecs.Generators/Tralys.Ecs.Generators.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="GeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(GeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Using Include="Tralys.Ecs.Generated" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tralys.Ecs.Tests" />
    <InternalsVisibleTo Include="Tralys.Ecs.Benchmarks" />
  </ItemGroup>
</Project>
